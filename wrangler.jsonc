{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "on-mange-quand",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  // La page (public/) est servie telle quelle ; les adresses /api/* passent par le serveur.
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "on-mange-quand",
      "database_id": "3d125fa7-ac16-4ba9-ae7b-c427c40fe56d",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true },
  // Chaque nuit à 3 h (UTC) : effacement automatique, voir purge() dans src/worker.js.
  "triggers": { "crons": ["0 3 * * *"] },
  // Limites de débit par adresse IP (src/worker.js, tooFast) : écritures en général, créations de sondage en plus.
  "ratelimits": [
    { "name": "LIMIT_WRITE", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } },
    { "name": "LIMIT_CREATE", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } }
  ],
  // Projet Firebase des comptes (vide = comptes désactivés). En local, « npm run dev » utilise l'émulateur.
  "vars": { "FIREBASE_PROJECT_ID": "on-mange-quand-5a00a" },
  "env": {
    // Version de test (--env test) : sa propre adresse et sa propre base, séparées de la prod.
    "test": {
      "name": "on-mange-quand-test",
      "vars": { "FIREBASE_PROJECT_ID": "on-mange-quand-5a00a" },
      "triggers": { "crons": ["0 3 * * *"] },
      "ratelimits": [
        { "name": "LIMIT_WRITE", "namespace_id": "1101", "simple": { "limit": 60, "period": 60 } },
        { "name": "LIMIT_CREATE", "namespace_id": "1102", "simple": { "limit": 10, "period": 60 } }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "on-mange-quand-test",
          "database_id": "4b6ab62f-9109-40ca-840b-b5d3ebe142ad",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}
